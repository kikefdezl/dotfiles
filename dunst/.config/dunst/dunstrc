[global]
monitor= 0
follow = mouse
width = (100, 500)
height = (100, 400)
offset = (60, 48)
indicate_hidden = yes
shrink = no
separator_height = 0
padding = 24
horizontal_padding = 24
frame_width = 2
sort = no
idle_threshold = 120
font = TX-02 Bold 14
line_height = 0
markup = full
format = %s\n%b
alignment = left
show_age_threshold = 60
word_wrap = yes
ignore_newline = no
stack_duplicates = false
hide_duplicate_count = yes
show_indicators = no
icon_position = left
sticky_history = yes
history_length = 20
browser = /usr/bin/firefox -new-tab
always_run_script = true
title = Dunst
class = Dunst
corner_radius = 10
progress_bar = true
separator_color = frame
highlight = "#dc8a78"
frame_color = "#dc8a78"

[urgency_low]
timeout = 4
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_normal]
background = "#1e1e2e"
foreground = "#cdd6f4"

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#fab387"
