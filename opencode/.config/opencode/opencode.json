{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "git commit": "deny",
      "git commit *": "deny",
      "git add": "deny",
      "git add *": "deny",
      "git restore *": "deny",
      "terraform apply": "deny",
      "terraform apply *": "deny",
      "tf apply": "deny",
      "tf apply *": "deny",
      "gcloud": "deny",
      "gcloud *": "deny"
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ]
}
