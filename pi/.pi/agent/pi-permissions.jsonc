{
  "defaultPolicy": {
    "tools": "allow",
    "bash": "ask",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },
  "tools": {
    "*": "allow"
  },
  "special": {
    "external_directory": "ask"
  },
  "bash": {
    "*": "allow",
    "*../*": "ask",
    "*cd ..*": "ask",
    "git commit": "deny",
    "git commit *": "deny",
    "git add": "deny",
    "git add *": "deny",
    "terraform apply": "deny",
    "terraform apply *": "deny",
    "tf apply": "deny",
    "tf apply *": "deny",
    "gcloud": "deny",
    "gcloud *": "deny"
  }
}
